# Anthropic Data Manager - Environment Configuration
# Copy this file to .env and update values as needed

# Flask Configuration
# IMPORTANT: Generate a secure secret key for production.
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-generated-64-character-secret
FLASK_ENV=development
DEBUG=false

# Server Configuration
HOST=0.0.0.0
PORT=5000

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/
DB_NAME=anthropic_data
MONGO_ROOT_USERNAME=anthropic_admin
MONGO_ROOT_PASSWORD=replace-with-strong-database-password

# For Docker with authentication:
# MONGO_URI=mongodb://anthropic_admin:<password>@mongodb:27017/anthropic_data?authSource=admin

# Production HTTP Basic Auth
APP_BASIC_AUTH_USERNAME=replace-with-app-username
APP_BASIC_AUTH_PASSWORD=replace-with-strong-app-password

# Optional mongo-express tools profile credentials
MONGO_EXPRESS_USERNAME=replace-with-tools-username
MONGO_EXPRESS_PASSWORD=replace-with-tools-password

# Upload Configuration
UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH=524288000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=console
